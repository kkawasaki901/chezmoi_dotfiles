{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.0.0/resources/zpack-schema.json",
  "name": "custom-pack",
  "version": "0.0.0",
  "description": "A basic widget pack for testing and development.",
  "tags": ["topbar"],
  "previewImages": ["./resources/preview-image-1.png"],
  "repositoryUrl": "",
  "widgets": [
    {
      "name": "vanilla",
      "htmlPath": "./vanilla.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": ["*.html", "*.css"],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": []
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_left",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "40px",
          "monitorSelection": {
            "type": "all"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    },
    {
      "name": "with-glazewm",
      "htmlPath": "./with-glazewm.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": true,
      "transparent": true,
      "includeFiles": ["*.html", "*.css", "*.json", "*.ps1", "resources/app-icons/*.png"],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": []
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_left",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "54px",
          "monitorSelection": {
            "type": "all"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    },
    {
      "name": "with-komorebi",
      "htmlPath": "./with-komorebi.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": true,
      "transparent": true,
      "includeFiles": ["*.html", "*.css"],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": []
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_left",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "40px",
          "monitorSelection": {
            "type": "all"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    },
    {
      "name": "app-launcher",
      "htmlPath": "./app-launcher.html",
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": ["*.html", "*.css", "*.json", "*.ps1", "resources/app-icons/*.png"],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": [
          { "program": "pwsh.exe", "argsRegex": "^-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File C:\\\\Users\\\\kawasaki\\\\.glzr\\\\zebar\\\\custom-pack\\\\Launch-App\\.ps1 -Index [0-9]{1,2}$" },
          { "program": "C:\\Users\\kawasaki\\AppData\\Local\\Zebar Launcher Editor\\zebar-launcher-editor.exe", "argsRegex": "^$" }
        ]
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_right",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "136px",
          "height": "100%",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": true,
            "edge": "right",
            "windowMargin": "0px"
          }
        }
      ]
    }
  ]
}
